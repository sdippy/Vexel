generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum Theme {
  black
  light
}

enum Language {
  en
  ru
}

enum PricePrecision {
  decimal
}

enum Currency {
  USDT
}

enum NotificationType {
  PRICE_BREAKOUT
  LIQUIDITY_SIGNAL
  DOWNSIDE_RISK
}

enum TransactionType {
  BUY
  SELL
}

enum TransactionStatus {
  PENDING
  EXECUTED
  FAILED
}

enum MarketNewsType {
  BULLISH
  BEARISH
  NEUTRAL
  BREAKING
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  TWO_FACTOR_SETUP
  LOGIN_CHALLENGE
}

// =========================
// USER
// =========================

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  avatarUrl    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     UserSettings?
  sessions     Session[]
  accounts     Account[]
  notifications Notification[]
  portfolios   Portfolio[]
  watchlists   Watchlist[]
  verificationTokens VerificationToken[]
}

// =========================
// USER SETTINGS
// =========================

model UserSettings {
  id              String          @id @default(uuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  theme           Theme?
  language        Language?
  currency        Currency?
  pricePrecision  PricePrecision?
  motion          Boolean         @default(true)

  updatedAt       DateTime        @updatedAt
}

// =========================
// NOTIFICATIONS
// =========================

model Notification {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  description String?
  volatility  String?
  isRead      Boolean           @default(false)

  createdAt   DateTime          @default(now())
}

// =========================
// PORTFOLIO
// =========================

model Portfolio {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// ASSET
// =========================

model AssetToken {
  id        String   @id @default(uuid())
  symbol    String   @unique

  transactions Transaction[]
  watchlistItems WatchlistItem[]
}

// =========================
// TRANSACTION
// =========================

model Transaction {
  id            String            @id @default(uuid())
  portfolioId   String
  assetTokenId  String

  portfolio     Portfolio         @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  assetToken    AssetToken        @relation(fields: [assetTokenId], references: [id])

  type          TransactionType
  status        TransactionStatus @default(EXECUTED)

  quantity      Decimal
  price         Decimal
  fee           Decimal?

  createdAt     DateTime          @default(now())
  executedAt    DateTime?
}

// =========================
// WATCHLIST (UNIFIED)
// =========================

model Watchlist {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isGlobal  Boolean  @default(false)

  items     WatchlistItem[]

  createdAt DateTime @default(now())
}

model WatchlistItem {
  id            String   @id @default(uuid())

  watchlistId   String
  assetTokenId  String

  watchlist     Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  assetToken    AssetToken @relation(fields: [assetTokenId], references: [id], onDelete: Cascade)

  createdAt     DateTime   @default(now())

  @@unique([watchlistId, assetTokenId])
}

// =========================
// MARKET NEWS
// =========================

model MarketNews {
  id          String          @id @default(uuid())
  topic       String
  label       String
  description String
  comment     String?
  source      String?
  author      String?
  timeToRead  String?
  typeTopic   MarketNewsType
  imageUrl    String?
  keywords    String[]

  createdAt   DateTime @default(now())
}

// =========================
// SESSION
// =========================

model Session {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash   String   @unique
  userAgent          String?
  ipAddress          String?
  deviceId           String?

  expiresAt          DateTime
  revokedAt          DateTime?

  createdAt          DateTime @default(now())
}

// =========================
// VERIFICATION TOKEN
// =========================

model VerificationToken {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String           @unique
  type        VerificationType

  expiresAt   DateTime
  usedAt      DateTime?

  createdAt   DateTime @default(now())
}

// =========================
// ACCOUNT (OAuth)
// =========================

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String
  providerAccountId String

  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}