generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MarketIntelligence {
  id          Int      @id @default(autoincrement())
  label       String
  timeToRead  String
  typeTopic   TopicType
  timeCreated DateTime @default(now())
  imageUrl    String?
}

enum TopicType {
  BULLISH
  BEARISH
  NEUTRAL
}